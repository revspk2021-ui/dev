# Mock is free and intentionally produces demonstration illustrations and tones.
PROVIDER_MODE=mock
DATA_DIR=./data
# To enable paid providers set PROVIDER_MODE=live and fill these locally.
OPENAI_API_KEY=
# For proxy-managed cloud credentials you may use LAZY_OPENAI_KEY instead.
LAZY_OPENAI_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
# Choose a size supported by your image model. Images are fitted to the video ratio locally.
OPENAI_IMAGE_SIZE_VERTICAL=1024x1536
OPENAI_IMAGE_SIZE_LANDSCAPE=1536x1024
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# A conservative limit; lower this if your chosen voice model requires it.
ELEVENLABS_TEXT_LIMIT=2000
